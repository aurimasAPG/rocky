OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: require this token for the team web UI
# ROCKY_TOKEN=

# Optional: pin the worker model (default is google/gemini-3.7-flash)
# ROCKY_WORKER=google/gemini-3.7-flash

# Optional: comma-separated folders the web UI may run in
# ROCKY_WORKSPACES=/path/to/projects,/path/to/other

# Optional: isolate the bash tool. none (default) | sandbox-exec (macOS) | docker
# ROCKY_SANDBOX=sandbox-exec
# ROCKY_SANDBOX_IMAGE=python:3.12-slim

# Optional: extra regexes that refuse a bash command, ;-separated
# ROCKY_BASH_DENY=npm\s+publish;terraform\s+apply
